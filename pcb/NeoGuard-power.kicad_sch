(text "J1 is not a devboard socket.\nPin22 unused: leave unconnected.\nMap cable wires by GPIO name.\nUSB remains on the external controller." (at 20 135 0) (effects (font (size 1.15 1.15) ) (justify left top) ) (uuid 46ea54b9-5a2e-5276-947a-6f7e87c06674))
(text "J9: 1=EXT3V3, 2=GND, 3=EXT5V\nEXT5V only if SD / buzzer needs it." (at 160 91 0) (effects (font (size 1.1 1.1) ) (justify left top) ) (uuid b928fde2-d26a-51d7-8e66-82fae18a0a4c))
(text "JP1: 1-2 DEV3V3; 2-3 EXT3V3\nOne shunt only. Do not bridge both." (at 285 91 0) (effects (font (size 1.1 1.1) ) (justify left top) ) (uuid 15256c32-0406-5cb6-9a68-8099c07eae30))
(text "JP2: 1-2 = 3V3; 2-3 = 5V\nSelect to match the actual SD module." (at 160 171 0) (effects (font (size 1.1 1.1) ) (justify left top) ) (uuid f37cd797-8339-501b-a0e1-abdb781e0017))
(text "JP3: 1-2 = 3V3; 2-3 = 5V\nSelect to match the actual buzzer." (at 285 171 0) (effects (font (size 1.1 1.1) ) (justify left top) ) (uuid 49b4add9-2a74-565f-bbda-08f3cb28b4ae))
