APP_NAME=NeoGuard Backend
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://neoguard:change-me@localhost:5432/neoguard
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
READING_STALE_AFTER_SECONDS=600
DEVICE_SYNC_MIN_INTERVAL_SECONDS=5
AI_MODE=prototype
# Optional absolute path override. Default is ../ai/artifacts/risk_model.json.
# AI_MODEL_PATH=C:/path/to/neonatal/ai/artifacts/risk_model.json
LOGIN_IDENTIFIER_MAX_ATTEMPTS=5
LOGIN_IDENTIFIER_WINDOW_SECONDS=900
LOGIN_SOURCE_MAX_ATTEMPTS=20
LOGIN_SOURCE_WINDOW_SECONDS=600
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@neoguard.local
# Optional; leave blank to enter a password interactively when seeding.
BOOTSTRAP_ADMIN_PASSWORD=
